# SACC 报名系统 · 环境变量示例（复制为 .env 使用，.env 不入库）
# 数据库文件路径（相对仓库根）
DB_PATH=./data/sacc.db
# 会话 token 密钥（必填，生产用强随机值）
JWT_SECRET=dev-secret-change-me
# WASM 模块路径
WASM_PATH=./backend/build/backend.wasm
# 前端构建产物目录
FRONTEND_DIST=./frontend/dist
# 宿主监听
HOST=0.0.0.0
PORT=3000
# 邮件发送（可选，未配则仅站内信）
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
